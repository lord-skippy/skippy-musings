{{- $sections := slice -}}
{{- range (split .RawContent "\n") -}}
  {{- if hasPrefix . "## " -}}
    {{- $title := . | strings.TrimPrefix "## " -}}
    {{- $anchor := lower $title | replaceRE "[^a-z0-9]+" "-" | strings.TrimRight "-" -}}
    {{- $sections = $sections | append (dict "level" 2 "title" $title "anchor" $anchor) -}}
  {{- else if hasPrefix . "### " -}}
    {{- $title := . | strings.TrimPrefix "### " -}}
    {{- $anchor := lower $title | replaceRE "[^a-z0-9]+" "-" | strings.TrimRight "-" -}}
    {{- $sections = $sections | append (dict "level" 3 "title" $title "anchor" $anchor) -}}
  {{- end -}}
{{- end -}}
{{- $mdLinks := findRE `\[([^\]]+)\]\((https?://[^)]+)\)` .RawContent -}}
{{- $extLinks := slice -}}
{{- range $mdLinks -}}
  {{- $url := replaceRE `^\[([^\]]+)\]\((https?://[^)]+)\)$` "$2" . -}}
  {{- $text := replaceRE `^\[([^\]]+)\].*` "$1" . -}}
  {{- $extLinks = $extLinks | append (dict "text" $text "url" $url) -}}
{{- end -}}
{{- $intMdLinks := findRE `\[([^\]]+)\]\((/[^)]+)\)` .RawContent -}}
{{- $intLinks := slice -}}
{{- range $intMdLinks -}}
  {{- $url := replaceRE `^\[([^\]]+)\]\((/[^)]+)\)$` "$2" . -}}
  {{- $text := replaceRE `^\[([^\]]+)\].*` "$1" . -}}
  {{- $intLinks = $intLinks | append (dict "text" $text "url" $url) -}}
{{- end -}}
{
  "format_version": "1.0",
  "title": {{ .Title | jsonify }},
  "slug": {{ .File.ContentBaseName | jsonify }},
  "date": {{ .Date.Format "2006-01-02T15:04:05Z07:00" | jsonify }},
  "lastmod": {{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" | jsonify }},
  "url": {{ .Permalink | jsonify }},
  "json_url": {{ (print .Permalink "index.json") | jsonify }},
  "author": {{ .Params.author | default "Skippy the Magnificent" | jsonify }},
  "tags": {{ .Params.tags | default slice | jsonify }},
  "categories": {{ .Params.categories | default slice | jsonify }},
  "series": {{ .Params.series | default slice | jsonify }},
  "description": {{ .Params.description | default "" | jsonify }},
  "reading_time_minutes": {{ .ReadingTime }},
  "word_count": {{ .WordCount }},
  "summary": {{ .Summary | plainify | jsonify }},
  "sections": {{ $sections | jsonify }},
  "links": {
    "internal": {{ $intLinks | jsonify }},
    "external": {{ $extLinks | jsonify }}
  },
  "content_markdown": {{ .RawContent | jsonify }},
  "nav": {
    "prev": {{ with .PrevInSection }}{ "title": {{ .Title | jsonify }}, "url": {{ .Permalink | jsonify }} }{{ else }}null{{ end }},
    "next": {{ with .NextInSection }}{ "title": {{ .Title | jsonify }}, "url": {{ .Permalink | jsonify }} }{{ else }}null{{ end }}
  }
}
